{
    "actorSpecification": 1,
    "fields": {
        "properties": {
            "schemaVersion": {
                "default": "1.2",
                "description": "Record schema version.",
                "type": "string"
            },
            "status": {
                "description": "success: all sources ok; partial: >=2 ok, some failed; insufficient_sources: <2 ok; invalid_destination: input not resolved.",
                "enum": [
                    "success",
                    "partial",
                    "insufficient_sources",
                    "invalid_destination"
                ],
                "type": "string"
            },
            "query": {
                "properties": {
                    "input": {
                        "description": "Destination exactly as supplied.",
                        "type": "string"
                    },
                    "canonicalDestination": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "Canonical English destination name."
                    },
                    "iso2": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "ISO 3166-1 alpha-2 code (XK for Kosovo)."
                    },
                    "iso3": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "ISO 3166-1 alpha-3 code."
                    },
                    "matchMethod": {
                        "anyOf": [
                            {
                                "enum": [
                                    "name",
                                    "alias",
                                    "iso_code",
                                    "fuzzy"
                                ],
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "How the input was resolved."
                    },
                    "candidates": {
                        "description": "Possible matches when the input is ambiguous.",
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "input",
                    "canonicalDestination",
                    "iso2",
                    "iso3",
                    "matchMethod"
                ],
                "type": "object"
            },
            "checkedAt": {
                "description": "ISO-8601 UTC time of the lookup.",
                "type": "string"
            },
            "sourcesRequested": {
                "items": {
                    "enum": [
                        "US",
                        "UK",
                        "CA"
                    ],
                    "type": "string"
                },
                "type": "array"
            },
            "sourcesSucceeded": {
                "items": {
                    "enum": [
                        "US",
                        "UK",
                        "CA"
                    ],
                    "type": "string"
                },
                "type": "array"
            },
            "sourcesFailed": {
                "items": {
                    "enum": [
                        "US",
                        "UK",
                        "CA"
                    ],
                    "type": "string"
                },
                "type": "array"
            },
            "errors": {
                "items": {
                    "properties": {
                        "sourceCode": {
                            "anyOf": [
                                {
                                    "enum": [
                                        "US",
                                        "UK",
                                        "CA"
                                    ],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Failed source, or null for destination errors."
                        },
                        "errorCode": {
                            "enum": [
                                "DESTINATION_NOT_FOUND",
                                "UPSTREAM_UNAVAILABLE",
                                "UPSTREAM_TIMEOUT",
                                "PARSER_FAILED",
                                "UNEXPECTED_SOURCE_FORMAT",
                                "INVALID_DESTINATION"
                            ],
                            "type": "string"
                        },
                        "message": {
                            "description": "Public error message (no stack traces).",
                            "type": "string"
                        },
                        "retryable": {
                            "description": "Whether retrying later may succeed.",
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "sourceCode",
                        "errorCode",
                        "message",
                        "retryable"
                    ],
                    "type": "object"
                },
                "type": "array"
            },
            "advisories": {
                "items": {
                    "properties": {
                        "sourceCode": {
                            "description": "US, UK or CA.",
                            "enum": [
                                "US",
                                "UK",
                                "CA"
                            ],
                            "type": "string"
                        },
                        "sourceName": {
                            "description": "Issuing government body.",
                            "type": "string"
                        },
                        "sourceUrl": {
                            "description": "Official human-readable advisory page.",
                            "type": "string"
                        },
                        "retrievalUrl": {
                            "description": "Official machine-readable URL actually fetched.",
                            "type": "string"
                        },
                        "retrievedAt": {
                            "description": "ISO-8601 UTC time the source was fetched.",
                            "type": "string"
                        },
                        "sourceUpdatedAt": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Source's own last-updated date/time (ISO-8601) if published."
                        },
                        "nativeLevel": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Native level identifier: US 'Level N', UK GOV.UK alert_status codes, CA advisory-state (an internal feed code, not a public Canadian level number)."
                        },
                        "nativeAdvice": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Native national advice wording; null when the source issues no national statement (UK)."
                        },
                        "nativeScale": {
                            "properties": {
                                "type": {
                                    "description": "'numbered' if the government publishes numbered levels, otherwise 'categorical'.",
                                    "enum": [
                                        "numbered",
                                        "categorical"
                                    ],
                                    "type": "string"
                                },
                                "description": {
                                    "description": "How this government expresses its own advisory levels.",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "type",
                                "description"
                            ],
                            "type": "object"
                        },
                        "normalizedSeverity": {
                            "properties": {
                                "overall": {
                                    "anyOf": [
                                        {
                                            "maximum": 4,
                                            "minimum": 1,
                                            "type": "integer"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "National advisory on the Actor's internal cross-source 1-4 scale (1 normal precautions, 2 increased caution, 3 avoid non-essential/reconsider travel, 4 avoid all travel). Not necessarily the government's native level. Null if not mappable."
                                },
                                "regionalMax": {
                                    "anyOf": [
                                        {
                                            "maximum": 4,
                                            "minimum": 1,
                                            "type": "integer"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Highest regional (sub-national) severity on the Actor's internal 1-4 scale. Null when no regional warning is known, including when regionalCoverage is 'unavailable' (unknown, not 'none')."
                                },
                                "hasRegionalEscalation": {
                                    "anyOf": [
                                        {
                                            "type": "boolean"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "True if some region is rated more severe than the national level; null if unknown (always null when regionalCoverage is 'unavailable')."
                                },
                                "basis": {
                                    "description": "How the normalized value was derived from the source's native value.",
                                    "type": "string"
                                },
                                "scaleNote": {
                                    "default": "Internal cross-source normalization used by this Actor for comparison (1 normal precautions, 2 increased caution, 3 avoid non-essential/reconsider travel, 4 avoid all travel). Not necessarily the source government's native advisory level; see nativeLevel, nativeAdvice and nativeScale for the official terminology.",
                                    "description": "Reminder that these values are the Actor's internal normalization, not native levels.",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "overall",
                                "regionalMax",
                                "hasRegionalEscalation",
                                "basis"
                            ],
                            "type": "object"
                        },
                        "riskCategories": {
                            "description": "Controlled-vocabulary risk categories (deterministic mapping).",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "nativeRiskLabels": {
                            "description": "Source labels/headings that produced the risk categories.",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "riskCategoriesBasis": {
                            "description": "Which part of the source the risk categories come from.",
                            "type": "string"
                        },
                        "regionalCoverage": {
                            "description": "'available': the source data was sufficient to determine regional-warning status; 'unavailable': this source/adapter does not provide enough regional detail, so regional status is unknown; 'not_applicable': regional breakdown does not apply to this destination.",
                            "enum": [
                                "available",
                                "unavailable",
                                "not_applicable"
                            ],
                            "type": "string"
                        },
                        "regionalCoverageNote": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Deterministic note explaining regionalCoverage or omitted regional warnings; null if none."
                        },
                        "regionalWarnings": {
                            "anyOf": [
                                {
                                    "items": {
                                        "properties": {
                                            "region": {
                                                "description": "Region name as published by the source (heading or advice text).",
                                                "type": "string"
                                            },
                                            "nativeAdvice": {
                                                "description": "The source's own advice wording for this region.",
                                                "type": "string"
                                            },
                                            "normalizedSeverity": {
                                                "anyOf": [
                                                    {
                                                        "maximum": 4,
                                                        "minimum": 1,
                                                        "type": "integer"
                                                    },
                                                    {
                                                        "type": "null"
                                                    }
                                                ],
                                                "description": "Regional advice on the shared 1-4 scale."
                                            },
                                            "nativeDetails": {
                                                "description": "Verbatim supporting text/bullets from the source (areas included or excepted).",
                                                "items": {
                                                    "type": "string"
                                                },
                                                "type": "array"
                                            }
                                        },
                                        "required": [
                                            "region",
                                            "nativeAdvice",
                                            "normalizedSeverity"
                                        ],
                                        "type": "object"
                                    },
                                    "type": "array"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Regional warnings. [] means the source was checked and lists no regional warnings. null means unknown/unavailable (regionalCoverage 'unavailable') or omitted (includeRegional false)."
                        }
                    },
                    "required": [
                        "sourceCode",
                        "sourceName",
                        "sourceUrl",
                        "retrievalUrl",
                        "retrievedAt",
                        "sourceUpdatedAt",
                        "nativeLevel",
                        "nativeAdvice",
                        "nativeScale",
                        "normalizedSeverity",
                        "riskCategories",
                        "nativeRiskLabels",
                        "riskCategoriesBasis",
                        "regionalCoverage",
                        "regionalCoverageNote",
                        "regionalWarnings"
                    ],
                    "type": "object"
                },
                "type": "array"
            },
            "comparison": {
                "anyOf": [
                    {
                        "properties": {
                            "availableSeverityValues": {
                                "description": "Normalized overall severities, in source order.",
                                "items": {
                                    "type": "integer"
                                },
                                "type": "array"
                            },
                            "lowestOverallSeverity": {
                                "anyOf": [
                                    {
                                        "maximum": 4,
                                        "minimum": 1,
                                        "type": "integer"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "highestOverallSeverity": {
                                "anyOf": [
                                    {
                                        "maximum": 4,
                                        "minimum": 1,
                                        "type": "integer"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "severitySpread": {
                                "anyOf": [
                                    {
                                        "type": "integer"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "max - min overall severity; null with fewer than two values."
                            },
                            "materialDisagreement": {
                                "anyOf": [
                                    {
                                        "type": "boolean"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "True when severitySpread >= 2; null if not computable."
                            },
                            "highestRegionalSeverity": {
                                "anyOf": [
                                    {
                                        "maximum": 4,
                                        "minimum": 1,
                                        "type": "integer"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Highest normalized severity among regional warnings actually observed in sources with available regional data. Null does not by itself mean that no regional warnings exist; consult regionalWarningConclusion and regionalCoverage."
                            },
                            "regionalCoverage": {
                                "properties": {
                                    "status": {
                                        "description": "complete: every successfully retrieved source has known regional coverage; partial: at least one known and at least one unavailable; unavailable: no successfully retrieved source has known regional coverage. Sources that failed entirely are reported in sourcesFailed/errors, not here.",
                                        "enum": [
                                            "complete",
                                            "partial",
                                            "unavailable"
                                        ],
                                        "type": "string"
                                    },
                                    "sourcesAvailable": {
                                        "description": "Successfully retrieved sources whose regional status is known (regionalCoverage is not 'unavailable').",
                                        "items": {
                                            "enum": [
                                                "US",
                                                "UK",
                                                "CA"
                                            ],
                                            "type": "string"
                                        },
                                        "type": "array"
                                    },
                                    "sourcesUnavailable": {
                                        "description": "Successfully retrieved sources whose regional status is unknown (regionalCoverage 'unavailable').",
                                        "items": {
                                            "enum": [
                                                "US",
                                                "UK",
                                                "CA"
                                            ],
                                            "type": "string"
                                        },
                                        "type": "array"
                                    },
                                    "allRequestedSourcesKnown": {
                                        "description": "True only if every requested source was retrieved and has known regional coverage.",
                                        "type": "boolean"
                                    }
                                },
                                "required": [
                                    "status",
                                    "sourcesAvailable",
                                    "sourcesUnavailable",
                                    "allRequestedSourcesKnown"
                                ],
                                "type": "object"
                            },
                            "regionalWarningConclusion": {
                                "description": "Deterministic cross-source conclusion about regional warnings. warnings_reported: at least one source with available regional coverage reports a regional warning. none_reported is used only when regional coverage is complete for all successfully retrieved requested sources and none reports a regional warning. unknown_due_to_incomplete_coverage means no regional warning was observed but at least one source's regional coverage is unavailable, so the Actor cannot conclude that no regional warnings exist.",
                                "enum": [
                                    "warnings_reported",
                                    "none_reported",
                                    "unknown_due_to_incomplete_coverage"
                                ],
                                "type": "string"
                            },
                            "sourcesWithRegionalWarnings": {
                                "description": "Sources with available regional coverage that report at least one regional warning.",
                                "items": {
                                    "enum": [
                                        "US",
                                        "UK",
                                        "CA"
                                    ],
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "sourcesAtHighestOverallSeverity": {
                                "items": {
                                    "enum": [
                                        "US",
                                        "UK",
                                        "CA"
                                    ],
                                    "type": "string"
                                },
                                "type": "array"
                            }
                        },
                        "required": [
                            "availableSeverityValues",
                            "lowestOverallSeverity",
                            "highestOverallSeverity",
                            "severitySpread",
                            "materialDisagreement",
                            "highestRegionalSeverity",
                            "regionalCoverage",
                            "regionalWarningConclusion",
                            "sourcesWithRegionalWarnings",
                            "sourcesAtHighestOverallSeverity"
                        ],
                        "type": "object"
                    },
                    {
                        "type": "null"
                    }
                ],
                "description": "Cross-source comparison; null for invalid destinations."
            },
            "billing": {
                "properties": {
                    "billable": {
                        "description": "Whether this lookup is charged (one destination-lookup event).",
                        "type": "boolean"
                    },
                    "eventName": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "Pay-per-event name charged, if billable."
                    },
                    "reason": {
                        "type": "string"
                    }
                },
                "required": [
                    "billable",
                    "eventName",
                    "reason"
                ],
                "type": "object"
            }
        },
        "required": [
            "status",
            "query",
            "checkedAt",
            "sourcesRequested",
            "sourcesSucceeded",
            "sourcesFailed",
            "errors",
            "advisories",
            "comparison",
            "billing"
        ],
        "type": "object"
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "Destination, status and cross-government severity comparison.",
            "transformation": {
                "flatten": [
                    "query",
                    "comparison",
                    "billing"
                ],
                "fields": [
                    "query.canonicalDestination",
                    "status",
                    "comparison.availableSeverityValues",
                    "comparison.severitySpread",
                    "comparison.materialDisagreement",
                    "comparison.highestRegionalSeverity",
                    "comparison.regionalWarningConclusion",
                    "sourcesSucceeded",
                    "sourcesFailed",
                    "billing.billable",
                    "checkedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "query.canonicalDestination": {
                        "label": "Destination",
                        "format": "text"
                    },
                    "status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "comparison.availableSeverityValues": {
                        "label": "Severities (1-4)",
                        "format": "array"
                    },
                    "comparison.severitySpread": {
                        "label": "Spread",
                        "format": "number"
                    },
                    "comparison.materialDisagreement": {
                        "label": "Material disagreement",
                        "format": "boolean"
                    },
                    "comparison.highestRegionalSeverity": {
                        "label": "Highest regional",
                        "format": "number"
                    },
                    "comparison.regionalWarningConclusion": {
                        "label": "Regional conclusion",
                        "format": "text"
                    },
                    "sourcesSucceeded": {
                        "label": "Sources OK",
                        "format": "array"
                    },
                    "sourcesFailed": {
                        "label": "Sources failed",
                        "format": "array"
                    },
                    "billing.billable": {
                        "label": "Billable",
                        "format": "boolean"
                    },
                    "checkedAt": {
                        "label": "Checked at",
                        "format": "date"
                    }
                }
            }
        },
        "advisories": {
            "title": "Advisories by government",
            "description": "One row per government source.",
            "transformation": {
                "unwind": [
                    "advisories"
                ],
                "fields": [
                    "sourceCode",
                    "nativeLevel",
                    "nativeAdvice",
                    "normalizedSeverity",
                    "riskCategories",
                    "sourceUpdatedAt",
                    "sourceUrl"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "sourceCode": {
                        "label": "Source",
                        "format": "text"
                    },
                    "nativeLevel": {
                        "label": "Native level",
                        "format": "text"
                    },
                    "nativeAdvice": {
                        "label": "Native advice",
                        "format": "text"
                    },
                    "normalizedSeverity": {
                        "label": "Normalized severity",
                        "format": "object"
                    },
                    "riskCategories": {
                        "label": "Risk categories",
                        "format": "array"
                    },
                    "sourceUpdatedAt": {
                        "label": "Source updated",
                        "format": "text"
                    },
                    "sourceUrl": {
                        "label": "Official page",
                        "format": "link"
                    }
                }
            }
        }
    }
}
